  <script>
    (function(){
      const toast = document.getElementById('toast');
      const showToast = (msg) => {
        toast.textContent = msg;
        toast.classList.add('show');
        window.clearTimeout(showToast._t);
        showToast._t = window.setTimeout(()=>toast.classList.remove('show'), 1500);
      };

      // date
      const d = new Date();
      const pad = n => String(n).padStart(2,'0');
      const iso = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
      document.getElementById('genDate').textContent = `生成日期：${iso}`;

      // Copy original
      const copyBtn = document.getElementById('copyOriginalBtn');
      const originalTextEl = document.getElementById('originalText');
      copyBtn?.addEventListener('click', async () => {
        try{
          await navigator.clipboard.writeText(originalTextEl.innerText);
          showToast('✅ 已复制原文');
        }catch(e){
          // fallback
          const r = document.createRange();
          r.selectNodeContents(originalTextEl);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(r);
          document.execCommand('copy');
          sel.removeAllRanges();
          showToast('✅ 已复制原文（兼容模式）');
        }
      });

      // Expand / Collapse all
      const allDetails = Array.from(document.querySelectorAll('details'));
      document.getElementById('expandAllBtn')?.addEventListener('click', () => {
        allDetails.forEach(d => d.open = true);
        showToast('📖 已展开全部');
      });
      document.getElementById('collapseAllBtn')?.addEventListener('click', () => {
        allDetails.forEach(d => d.open = false);
        showToast('🧘 已折叠全部');
      });

      // Copy title
      document.getElementById('copyTitleBtn')?.addEventListener('click', async () => {
        const t = document.title.replace(' · 深度学习卡片','');
        try{
          await navigator.clipboard.writeText(t);
          showToast('✅ 已复制标题');
        }catch(e){
          showToast('⚠️ 复制失败：浏览器不允许');
        }
      });

      // Filename logic (core semantics, remove special symbols)
      const getFileName = () => {
        const base = '佛陀说法_方便法门_zh';
        const safe = base
          .replace(/[^\\u4e00-\\u9fff\\w]+/g,'')
          .replace(/_+/g,'_')
          .replace(/^_+|_+$/g,'');
        return (safe || '深度学习卡片') + '.html';
      };

      // Download current HTML (including current open/closed state)
      const download = () => {
        const doctype = '<!doctype html>\\n';
        const html = doctype + document.documentElement.outerHTML;
        const blob = new Blob([html], {type:'text/html;charset=utf-8'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = getFileName();
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(()=>URL.revokeObjectURL(url), 1000);
        showToast('⬇️ 已开始下载');
      };

      document.getElementById('downloadBtn')?.addEventListener('click', download);
      document.getElementById('downloadBtn2')?.addEventListener('click', download);
    })();
  </script>
